{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git log*)",
      "Bash(ls*)",
      "Bash(node *ver-tela.js)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(curl*)",
      "Bash(wget*)"
    ]
  },
  "sandbox": {
    "excludedCommands": ["node *ver-tela.js"]
  }
}
